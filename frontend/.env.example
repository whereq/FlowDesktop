# FlowDesktop — frontend build variables
#
# These are the ONLY variables the frontend build reads. Copy this file to `.env`
# (or `.env.local`) and fill in your own values. Every variable is injected into
# the client bundle by Vite, so never put a secret or a private key here —
# anything in this file is publicly visible in the built assets.
#
# The API base URL is not configured here: the frontend calls the backend on the
# relative path `/api/v1`, which the dev server proxies (see vite.config.ts)
# and production serves from the same origin.

# Base URL of your Keycloak server (OIDC issuer root).
# Example: https://auth.example.com
VITE_KEYCLOAK_URL=

# Keycloak realm that hosts your FlowDesktop users.
# Example: flowdesktop
VITE_KEYCLOAK_REALM=

# Public (SPA) client id of the Keycloak client, e.g. flowdesktop-spa
VITE_KEYCLOAK_CLIENT_ID=
