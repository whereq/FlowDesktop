# =============================================================================
# FlowDesktop — environment template
#
#   cp docker/.env.example docker/.env
#
# Two things are required before FlowDesktop can do anything useful:
#
#   1. WHEREQ_API_KEY      — market data comes from the whereq.cloud Data API.
#                             There is no bundled scraper and no anonymous path.
#   2. KEYCLOAK_URL,       — authentication is delegated to your own OpenID
#      KEYCLOAK_REALM,        Connect provider. Nothing about it is bundled.
#      KEYCLOAK_CLIENT_ID
#
# Everything else is optional. Leave the LLM keys blank to run in BYOK mode,
# where each user supplies their own key.
# =============================================================================

# ── Market data (required) ─────────────────────────────────────────────────
# Your whereq.cloud Data API key. Get one from your whereq.cloud dashboard.
# The key is sent in the X-API-Key header on every request.
WHEREQ_API_KEY=

# Only change this for a self-hosted or regional Data API deployment.
WHEREQ_API_URL=https://api.whereq.cloud

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=flowdesktop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowdesktop
DB_PORT=5432

# ── Ports ──────────────────────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=8080

# ── Identity provider (OIDC, required) ─────────────────────────────────────
# The backend verifies bearer tokens against <KEYCLOAK_URL>/realms/<realm>
# and reads roles from the token. The frontend needs the same three values at
# BUILD time.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=flowdesktop
KEYCLOAK_CLIENT_ID=flowdesktop-spa
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=flowdesktop
VITE_KEYCLOAK_CLIENT_ID=flowdesktop-spa

# Realm role that unlocks admin-only surfaces.
ADMIN_ROLE=fd-admin

# Service account used to assign roles after a subscription purchase.
# Leave blank to disable the paid-tier flow.
KEYCLOAK_ADMIN_CLIENT_ID=flowdesktop-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── LLM providers (platform mode) ──────────────────────────────────────────
# In BYOK mode these are unused — every request carries the user's own key.
# Set PLATFORM_LLM_PROVIDER to avoid auto-detection ambiguity when more than
# one key is present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
PLATFORM_LLM_PROVIDER=

# ── Payments (optional) ────────────────────────────────────────────────────
# Leave blank to disable the subscription flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Web Push (optional) ───────────────────────────────────────────────────
# A base64-encoded PKCS8 PEM on a single line. Leave blank to disable.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Collection tuning ──────────────────────────────────────────────────────
COLLECTION_INTERVAL_MINUTES=5
HISTORICAL_DAYS=365
